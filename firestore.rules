rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- HELPER FUNCTIONS ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    // Tier 1: Super Admin (owner — full control)
    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'super_admin';
    }

    // Tier 2: Admin OR Super Admin
    function isAdmin() {
      return isSignedIn() &&
        (getUserRole() == 'admin' || getUserRole() == 'super_admin');
    }

    // Tier 3: Moderator OR above (staff)
    function isModerator() {
      return isSignedIn() &&
        (getUserRole() == 'moderator' ||
         getUserRole() == 'admin' ||
         getUserRole() == 'super_admin');
    }

    // Tier 3: Agency (franchise partner)
    function isAgency() {
      return isSignedIn() && getUserRole() == 'agency';
    }

    // Business owner check
    function isBusinessOwner(businessId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    // Agency owns a specific business
    function isAgencyOwner(businessId) {
      return isSignedIn() &&
        isAgency() &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.agencyUid == request.auth.uid;
    }

    // ---------- USERS ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isModerator();
      allow create: if isOwner(uid) &&
        !('role' in request.resource.data && request.resource.data.role != 'customer');
      allow update: if
        // Admin can do anything (including changing other users' roles)
        isAdmin() ||
        // Owner can update profile but NOT role, NOT coins (unless below)
        (isOwner(uid) &&
         request.resource.data.role == resource.data.role &&
         (
           request.resource.data.coins == resource.data.coins ||
           (request.resource.data.coins >= resource.data.coins &&
            request.resource.data.coins <= resource.data.coins + 100)
         ));
      allow delete: if isSuperAdmin();
    }

    // ---------- BUSINESSES ----------
    // Public read. Owner OR admin can edit. Agency can edit their area's businesses.
        match /businesses/{businessId} {
      allow read: if true;
      
      // Owner creates their own business, OR admin/moderator creates on behalf
      allow create: if isSignedIn() &&
        (
          request.resource.data.ownerUid == request.auth.uid ||
          isAdmin() ||
          isModerator()
        );
      
      allow update: if isSignedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         isAdmin() ||
         isModerator() ||
         isAgencyOwner(businessId));
      
      allow delete: if isAdmin();
    }

    // ---------- OFFERS ----------
    // Public read. Owner + admin + moderator can edit.
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        isBusinessOwner(request.resource.data.businessId);
      allow update: if isSignedIn() &&
  (
    // Customer booking: bookedSlots only (check FIRST)
    (
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedSlots', 'updatedAt'])
    ) ||
    // Customer claiming: claimedCount only
    (
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedCount', 'updatedAt']) &&
      request.resource.data.claimedCount == resource.data.claimedCount + 1
    ) ||
    isBusinessOwner(resource.data.businessId) ||
    isAdmin() ||
    isModerator()
  );
      allow delete: if isAdmin();
    }

    // ---------- CLAIMS ----------
    match /claims/{claimId} {
      allow read: if isSignedIn() &&
        (resource.data.userUid == request.auth.uid ||
         isBusinessOwner(resource.data.businessId) ||
         isModerator());
      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.userUid == request.auth.uid ||
         isBusinessOwner(resource.data.businessId) ||
         isAdmin() ||
         isModerator());
      allow delete: if isAdmin();
    }

    // ---------- GROUP DEALS ----------
    match /group_deals/{offerId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        isBusinessOwner(request.resource.data.businessId);
      allow update: if isSignedIn() &&
        (request.auth.uid in resource.data.participantUids ||
         request.auth.uid in request.resource.data.participantUids ||
         isBusinessOwner(resource.data.businessId) ||
         isAdmin() ||
         isModerator());
      allow delete: if isAdmin();
    }

    // ---------- REVIEWS ----------
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.userUid == request.auth.uid || isModerator());
      allow delete: if isSignedIn() &&
        (resource.data.userUid == request.auth.uid || isAdmin());
    }

    // ---------- REFERRALS ----------
    match /referrals/{referralId} {
      allow read: if isSignedIn() &&
        (resource.data.referrerUid == request.auth.uid ||
         resource.data.referredUid == request.auth.uid ||
         isModerator());
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{notifId} {
      allow read: if isSignedIn() &&
        resource.data.userUid == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        resource.data.userUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ---------- COIN TRANSACTIONS ----------
    match /coin_transactions/{txId} {
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isModerator());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ---------- SAVED OFFERS ----------
    match /saved_offers/{docId} {
      allow read: if isSignedIn() &&
        (
          (resource != null && resource.data.userUid == request.auth.uid) ||
          (resource == null)
        );
      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        resource.data.userUid == request.auth.uid;
    }

    // ---------- SAVED BUSINESSES ----------
    match /saved_businesses/{docId} {
      allow read: if isSignedIn() &&
        (
          (resource != null && resource.data.userUid == request.auth.uid) ||
          (resource == null)
        );
      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        resource.data.userUid == request.auth.uid;
    }

    // ---------- CATEGORIES ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }

        // ---------- GEOGRAPHY (B3) ----------
    // Countries, Zones, Areas — public read, admin/moderator write
    match /countries/{countryCode} {
      allow read: if true;
      allow create, update: if isAdmin() || isModerator();
      allow delete: if isAdmin();
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow create, update: if isAdmin() || isModerator();
      allow delete: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow create, update: if isAdmin() || isModerator();
      allow delete: if isAdmin();
    }

    // ---------- AGENCIES (B3) ----------
    // Agency partners — public read, admin write, owner can update own profile
    match /agencies/{agencyId} {
      allow read: if true;
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ---------- LANGUAGES (D6-B) ----------
    // Public read, admin write
    match /languages/{langCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- APP STRINGS (D6-B) ----------
    // Public read, admin write
    match /app_strings/{stringId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- CUSTOMER BEHAVIOR (D2) ----------
    // Analytics events — customer writes, admin/moderator reads
    match /customer_behavior/{eventId} {
      allow read: if isModerator();
      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    // ---------- CONFIG (C4) ----------
    // Global config (per-offer fees, commission tiers)
        match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    // ---------- PLANS (C2) ----------
    // Subscription plans — public read, admin write
    match /plans/{planId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---------- SUBSCRIPTIONS (C2) ----------
    // Business subscriptions — owner read, admin write
    match /subscriptions/{subId} {
      allow read: if isSignedIn() &&
        (isAdmin() || isModerator() ||
         resource.data.businessId == request.auth.uid ||
         resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ---------- PAYMENTS (C2) ----------
    // Payment records — admin/moderator read+write only
    match /payments/{paymentId} {
      allow read: if isAdmin() || isModerator();
      allow create, update: if isAdmin() || isModerator();
      allow delete: if isAdmin();
    }

    // ---------- REVENUE TRANSACTIONS (C2) ----------
    match /revenue_transactions/{txId} {
      allow read: if isAdmin() || isModerator();
      allow create, update: if isAdmin() || isModerator();
      allow delete: if isAdmin();
    }

    // ---------- AGENCY PAYOUTS (C2) ----------
    match /agency_payouts/{payoutId} {
      allow read: if isAdmin() ||
        (isAgency() && resource.data.agencyUid == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }


    // ═══════════════════════════════════════════════════════
    // PHASE H — MIGO RESERVE (Guaranteed Reservation System)
    // Added: 2026-10-10
    // ═══════════════════════════════════════════════════════

    // ---------- RESERVATIONS ----------
    match /reservations/{resId} {
              allow create: if isSignedIn() &&
          request.resource.data.status == 'reserved';

              allow read: if isSignedIn();

        // Explicit list permission for queries
        allow list: if isSignedIn();

      allow update: if isSignedIn() && (
        (resource.data.userUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'cancelledAt', 'cancelledBy', 'updatedAt'])) ||
        (resource != null && isBusinessOwner(resource.data.businessId)) ||
        isModerator()
      );

      allow delete: if isSuperAdmin();
    }

    // ---------- RESERVATION RULES ----------
    match /reservation_rules/{ruleId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---------- NO-SHOW LOG ----------
    match /no_show_log/{logId} {
      allow read: if isModerator() ||
        (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn() && (
        isAdmin() ||
        (resource != null && isBusinessOwner(resource.data.businessId))
      );
      allow update, delete: if isAdmin();
    }

    // ---------- RESERVATION CONFIG ----------
    match /reservation_config/{configId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---------- RESERVATION BANS ----------
    match /reservation_bans/{userUid} {
      allow read: if isSignedIn() && (
        request.auth.uid == userUid ||
        isModerator()
      );
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }

    // ---------- RESERVATION RULES ACCEPTANCE ----------
    match /reservation_rules_acceptance/{acceptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════
    // END PHASE H
    // ═══════════════════════════════════════════════════════


    // ---------- DEFAULT: DENY ----------
  }
}