rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- HELPER FUNCTIONS ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'super_admin';
    }

    function isModerator() {
      return isSignedIn() &&
        (getUserRole() == 'moderator' ||
         getUserRole() == 'admin' ||
         getUserRole() == 'super_admin');
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

        // ---------- USERS ----------
    // Each user can read/write their own profile.
    // Admins can read all.
    // Users CANNOT change their own role (only admin can).
    // Users CANNOT change own coins (only system via batch increments).
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isModerator();
      allow create: if isOwner(uid) &&
        !('role' in request.resource.data && request.resource.data.role != 'customer');
      allow update: if
        // Admin can do anything
        isAdmin() ||
        // Owner can update profile but NOT role, NOT coins
        (isOwner(uid) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.coins == resource.data.coins)
        ||
        // Owner can increment coins by small amounts (claim/redeem/review rewards)
        (isOwner(uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'updatedAt']) &&
         request.resource.data.coins >= resource.data.coins &&
         request.resource.data.coins <= resource.data.coins + 100);
      allow delete: if isAdmin();
    }

    // ---------- BUSINESSES ----------
    // Public read (anyone can browse shops).
    // Only owner or admin can edit/delete.
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

        // ---------- OFFERS ----------
    // Public read.
    // Business owner can create/edit their own offers.
    // Admin can edit/approve/reject all.
    // Customers can increment claimedCount (only that field).
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        isBusinessOwner(request.resource.data.businessId);
      allow update: if isSignedIn() &&
        (
          isBusinessOwner(resource.data.businessId) ||
          isAdmin() ||
          isModerator() ||
          // Customer claiming: only claimedCount can change
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedCount', 'updatedAt']) &&
            request.resource.data.claimedCount == resource.data.claimedCount + 1
          )
        );
      allow delete: if isAdmin();
    }

    // ---------- CLAIMS ----------
    // Customer can read/create their own claims.
    // Business owner can read claims for their business.
    // Redeem logic handled in app (owner updates status).
    match /claims/{claimId} {
      allow read: if isSignedIn() &&
        (resource.data.userUid == request.auth.uid ||
         isBusinessOwner(resource.data.businessId) ||
         isAdmin() ||
         isModerator());

      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;

      allow update: if isSignedIn() &&
        (resource.data.userUid == request.auth.uid ||
         isBusinessOwner(resource.data.businessId) ||
         isAdmin());

      allow delete: if isAdmin();
    }

    // ---------- GROUP DEALS ----------
    match /group_deals/{offerId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        isBusinessOwner(request.resource.data.businessId);
      allow update: if isSignedIn() &&
        (request.auth.uid in resource.data.participantUids ||
         request.auth.uid in request.resource.data.participantUids ||
         isBusinessOwner(resource.data.businessId) ||
         isAdmin());
      allow delete: if isAdmin();
    }

    // ---------- REVIEWS ----------
    // Public read (anyone can see reviews).
    // Only the author can edit/delete their review.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.userUid == request.auth.uid || isModerator() || isAdmin());
      allow delete: if isSignedIn() &&
        (resource.data.userUid == request.auth.uid || isAdmin());
    }

    // ---------- REFERRALS ----------
    // Only referrer/referred can read. System writes (via app).
    match /referrals/{referralId} {
      allow read: if isSignedIn() &&
        (resource.data.referrerUid == request.auth.uid ||
         resource.data.referredUid == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ---------- NOTIFICATIONS ----------
    // Only the target user can read/mark-read.
    // Creation done by system (any signed-in user OK because claims/redeems trigger them).
    match /notifications/{notifId} {
      allow read: if isSignedIn() &&
        resource.data.userUid == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        resource.data.userUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ---------- COIN TRANSACTIONS ----------
    // Read own only. Writes handled by system (signed-in users during claim/redeem).
    match /coin_transactions/{txId} {
      allow read: if isSignedIn() &&
        resource.data.uid == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

        // ---------- SAVED OFFERS ----------
    match /saved_offers/{docId} {
      // Read: doc exists and belongs to me, OR doc doesn't exist (get check)
      allow read: if isSignedIn() &&
        (
          (resource != null && resource.data.userUid == request.auth.uid) ||
          (resource == null) // doc doesn't exist — isOfferSaved() check
        );

      // Create: request.resource exists and belongs to me
      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;

      // Update/delete: doc exists and belongs to me
      allow update, delete: if isSignedIn() &&
        resource.data.userUid == request.auth.uid;
    }

        // ---------- SAVED BUSINESSES ----------
    match /saved_businesses/{docId} {
      allow read: if isSignedIn() &&
        (
          (resource != null && resource.data.userUid == request.auth.uid) ||
          (resource == null)
        );
      allow create: if isSignedIn() &&
        request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        resource.data.userUid == request.auth.uid;
    }

    // ---------- DEFAULT: DENY ----------
    // Any collection not listed above is blocked.
  }
}