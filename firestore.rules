      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // ÃƒÂ Ã‚Â´Ã‚Â¸ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã¢â‚¬Â¢ÃƒÂ Ã‚Â´Ã‚Â¾ÃƒÂ Ã‚ÂµÃ‚Â» ÃƒÂ Ã‚Â´Ã…Â¡ÃƒÂ Ã‚ÂµÃ¢â‚¬Â ÃƒÂ Ã‚Â´Ã‚Â¯ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã‚Â¯ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã‚Â¨ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã‚Â¨ ÃƒÂ Ã‚Â´Ã‚Â¬ÃƒÂ Ã‚Â´Ã‚Â¿ÃƒÂ Ã‚Â´Ã‚Â¸ÃƒÂ Ã‚Â´Ã‚Â¿ÃƒÂ Ã‚Â´Ã‚Â¨ÃƒÂ Ã‚Â´Ã‚Â¸ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã‚Â¸ÃƒÂ Ã‚ÂµÃ‚Â ÃƒÂ Ã‚Â´Ã¢â‚¬Â°ÃƒÂ Ã‚Â´Ã…Â¸ÃƒÂ Ã‚Â´Ã‚Â®ÃƒÂ Ã‚Â´Ã‚Â¯ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã…Â¸ÃƒÂ Ã‚ÂµÃ¢â‚¬Â  UID ÃƒÂ Ã‚Â´Ã¢â‚¬Â ÃƒÂ Ã‚Â´Ã‚Â£ÃƒÂ Ã‚ÂµÃ¢â‚¬Â¹ ÃƒÂ Ã‚Â´Ã…Â½ÃƒÂ Ã‚Â´Ã‚Â¨ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã‚Â¨ÃƒÂ Ã‚ÂµÃ‚Â ÃƒÂ Ã‚Â´Ã‚ÂªÃƒÂ Ã‚Â´Ã‚Â°ÃƒÂ Ã‚Â´Ã‚Â¿ÃƒÂ Ã‚Â´Ã‚Â¶ÃƒÂ Ã‚ÂµÃ¢â‚¬Â¹ÃƒÂ Ã‚Â´Ã‚Â§ÃƒÂ Ã‚Â´Ã‚Â¿ÃƒÂ Ã‚Â´Ã¢â‚¬Â¢ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã¢â‚¬Â¢ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã‚Â¨ÃƒÂ Ã‚ÂµÃ‚ÂÃƒÂ Ã‚Â´Ã‚Â¨ÃƒÂ Ã‚ÂµÃ‚Â
      allow update: if isSignedIn() && (
        isModerator() ||
        isAdmin() ||
        request.auth.uid == resource.data.businessId || 
        request.auth.uid == resource.data.ownerUid
      );
    }

    // ---------- COMPLAINTS ----------
    match /community_complaints/{complaintId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isModerator() || 
        isAdmin()
      );
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isModerator() || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ---------- DEMAND MATCHING (Admin Review Queue) ----------
    match /demand_matches/{matchId} {
      allow read: if isModerator();
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }

    // ---------- DEFAULT: DENY ----------
  }
}
