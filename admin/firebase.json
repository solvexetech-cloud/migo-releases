{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
        "rewrites": [
      {
        "source": "/r/**",
        "destination": "/r/index.html"
      },
      {
        "source": "/o/**",
        "destination": "/o/index.html"
      },
      {
        "source": "/creator/**",
        "destination": "/creator/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}